{
  "name": "citadel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Citadel-P/Citadel"
  },
  "scripts": {
    "dev": "vite",
    "build:prod": "tsc -b && vite build && npm run lint",
    "build:image": "tsc -b && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:verify": "npm run api:generate && git diff --exit-code -- src/api/schema/swagger.json src/api/generated/api.types.ts src/api/generated/resources.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier --config ./.prettierrc --write \"src/**/*{.ts,.tsx,.html,.scss,.json}\"",
    "prettier:verify": "prettier --config ./.prettierrc --check \"src/**/*{.ts,.tsx,.html,.scss,.json}\"",
    "preview": "vite preview",
    "api:generate": "tsx scripts/sync-rust-schema.ts && swagger-typescript-api generate --custom-config ./scripts/api-generator.config.mjs --path ./src/api/schema/swagger.json -o ./src/api/ -n generated/api.types.ts --responses && tsx scripts/generate-resources.ts"
  },
  "dependencies": {
