    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "jotai": "^2.19.1",
    "js-yaml": "^4.1.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.55.1",
