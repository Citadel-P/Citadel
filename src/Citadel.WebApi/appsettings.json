{
    "ConnectionStrings": {
        "Postgres": "Host=pg_db;Database=citadel_db;Username=admin;Password=admin"
    },
    "Jwt": {
        "Issuer": "http://localhost:8000",
        "Audience": "http://localhost:8000",
        "AccessToken": { "ValidForMinutes": 15 },
        "RefreshToken": { "ValidForDays": 30 },
        "Key": ""
    },
    "JobConfiguration": {
        "MonitoringInterval": 10,
        "BatchSize": 500,
        "FlashInterval": 60
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:8000"
            }
        }
    },
    "EnableLogColor": false,
    "EnableSwagger": false,
    "Cors": [ "http://localhost:8000", "http://localhost:5173" ]
}