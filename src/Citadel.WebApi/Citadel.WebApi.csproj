<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<RootNamespace>WebApi</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<OpenApiDocumentsDirectory>..\schema</OpenApiDocumentsDirectory>
	<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
	<OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
	<DockerfileFile>..\..\Dockerfile</DockerfileFile>
	<DockerfileContext>$(MSBuildProjectDirectory)\..\..</DockerfileContext>
	<DockerfileRunArguments>-p 8000:8000 -v "citadel_data:/app/data" -v "/var/run/docker.sock:/var/run/docker.sock"</DockerfileRunArguments>
	<ContainerRepository>citadel-webapi</ContainerRepository>
	<PreserveCompilationContext>true</PreserveCompilationContext>
	<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Dockerfile" Link="Dockerfile" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	  <PackageReference Include="Nerdbank.MessagePack.SignalR" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Citadel.Contracts\src\Citadel.Hosting\Citadel.Hosting.csproj" />
	<ProjectReference Include="..\Citadel.Application\Citadel.Application.csproj" />
	<ProjectReference Include="..\Citadel.Infrastructure\Citadel.Infrastructure.csproj" />
	<ProjectReference Include="..\Citadel.Contracts\src\Citadel.SourceGen\Citadel.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
