FROM rust@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8

RUN --mount=type=cache,id=citadel-schema-dpm-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=citadel-schema-dpm-target,target=/tmp/dpm-target \
    CARGO_TARGET_DIR=/tmp/dpm-target \
    cargo install declarative-postgres-migrate \
        --version 0.3.2 \
        --locked \
        --root /usr/local

ENTRYPOINT ["dpm"]
