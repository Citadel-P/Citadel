{
  "name": "citadel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Citadel-P/Citadel"
  },
  "scripts": {
    "dev": "vite",
    "build:prod": "tsc -b && npm run test:monaco && vite build && npm run lint",
    "build:image": "tsc -b && npm run lint && npm run test:monaco && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:verify": "tsx scripts/api-generation.ts verify",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier --config ./.prettierrc --write \"src/**/*{.ts,.tsx,.html,.scss,.json}\"",
    "prettier:verify": "prettier --config ./.prettierrc --check \"src/**/*{.ts,.tsx,.html,.scss,.json}\"",
    "preview": "vite preview",
    "api:generate": "tsx scripts/api-generation.ts generate",
    "test:monaco": "node --test scripts/verify-monaco-sanitizer.mjs"
  },
  "dependencies": {
