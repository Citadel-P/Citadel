<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>Infrastructure</RootNamespace>
	<Dapper_SqlSyntax>PostgreSQL</Dapper_SqlSyntax>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Dapper" />
	<PackageReference Include="Dapper.AOT" />
	<PackageReference Include="dbup-postgresql" />
	<PackageReference Include="FluentMigrator" />
	<PackageReference Include="Refit" />
	<PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
	<PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Citadel.Hosting.DockerClient.csproj" />
	  <ProjectReference Include="..\Citadel.Domain\Citadel.Domain.csproj" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Scripts\*.sql" /> <!--for dbup-->
	</ItemGroup>

   <ItemGroup>
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\container_service.proto" GrpcServices="Client" Link="Protos\container_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\image_service.proto" GrpcServices="Client" Link="Protos\image_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\platform_service.proto" GrpcServices="Client" Link="Protos\platform_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\network_service.proto" GrpcServices="Client" Link="Protos\network_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\volume_service.proto" GrpcServices="Client" Link="Protos\volume_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\deployment_service.proto" GrpcServices="Client" Link="Protos\deployment_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\stack_service.proto" GrpcServices="Client" Link="Protos\stack_service.proto" />

	   <Protobuf Include="..\Citadel.Contracts\src\Citadel.Hosting.DockerClient\Protos\shared_models.proto" GrpcServices="None" Link="Protos\Common\shared_models.proto" />
   </ItemGroup>

   <ItemGroup>
     <Folder Include="Scripts\" />
   </ItemGroup>

</Project>
