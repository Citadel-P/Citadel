    "AlertChannel": { "maximumLevel": "Execute", "specifics": {} },
    "User": { "maximumLevel": "Execute", "specifics": {} },
    "Team": { "maximumLevel": "Execute", "specifics": {} },
    "Role": { "maximumLevel": "Execute", "specifics": {} },
    "Binding": { "maximumLevel": "Execute", "specifics": {} },
