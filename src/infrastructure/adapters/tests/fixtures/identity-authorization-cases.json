        "Pull": "Read",
        "Terminal": "Read",
        "Inspect": "Read",
        "ManageNodeAgents": "Execute"
      }
    },
    "Deployment": {
      "maximumLevel": "Execute",
      "specifics": {
        "Apply": "Read",
        "ResourceBindings": "Read",
        "Logs": "Read",
        "Terminal": "Read",
        "Inspect": "Read"
      }
    },
    "Stack": {
      "maximumLevel": "Execute",
      "specifics": {
        "Apply": "Read",
        "ResourceBindings": "Read",
        "Releases": "Read",
        "Logs": "Read",
        "Inspect": "Read"
      }
