{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Citadel: Debug Rust API",
      "preLaunchTask": "Citadel: Prepare Rust API",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--manifest-path",
          "${workspaceFolder}/rust/Cargo.toml",
          "-p",
          "citadel-server"
        ],
        "filter": {
          "name": "citadel-server",
          "kind": "bin"
        }
      },
      "args": ["serve"],
      "envFile": "${workspaceFolder}/rust/.env.development",
      "cwd": "${workspaceFolder}/rust",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Citadel: Run UI for debugging",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Citadel: Prepare development environment",
      "command": "bash \"${workspaceFolder}/rust/scripts/dev.sh\" exec npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
      "cwd": "${workspaceFolder}/src/Citadel.FrontEnd"
    }
  ],
  "compounds": [
    {
      "name": "Citadel: Debug application",
      "configurations": ["Citadel: Debug Rust API", "Citadel: Run UI for debugging"],
      "stopAll": true
    }
  ]
}
