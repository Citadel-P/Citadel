<Project>
  <PropertyGroup>
    <Authors>Citadel contributors</Authors>
    <Copyright>Copyright © Citadel contributors 2024–present</Copyright>
    <Description>Citadel API for managing platforms, containers, registries, images, networks, and volumes.</Description>
    <TargetFramework>net11.0</TargetFramework>
	<Features>runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<PublishTrimmed>true</PublishTrimmed>
	<IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
	<OptimizationPreference>Size</OptimizationPreference>
	<UseAppHost>true</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/Citadel-P/Citadel</RepositoryUrl>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
	
	<ItemGroup Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">
		<PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
	</ItemGroup>
</Project>
