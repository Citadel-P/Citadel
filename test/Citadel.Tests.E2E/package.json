{
  "name": "citadel-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:core-runtime": "playwright test tests/core-runtime",
    "test:nightly-runtime": "playwright test tests/nightly",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots=all",
    "test:accessibility": "playwright test tests/accessibility",
    "test:oidc": "playwright test tests/compatibility/oidc.spec.ts",
    "test:vault": "playwright test tests/compatibility/vault.spec.ts",
    "typecheck": "tsc --noEmit",
    "install:chromium": "playwright install chromium",
    "env:up": "docker compose -f compose.yml up -d --wait",
    "env:down": "docker compose -f compose.yml down --volumes --remove-orphans",
    "env:oidc:up": "docker compose -f compose.yml --profile oidc up -d --wait",
    "env:oidc:down": "docker compose -f compose.yml --profile oidc down --volumes --remove-orphans",
    "env:vault:up": "docker compose -f compose.yml --profile vault up -d --wait",
    "env:vault:down": "docker compose -f compose.yml --profile vault down --volumes --remove-orphans"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
