# ------------------------------------------------------------------
# --------------- CITADEL Settings ---------------------------------
# ------------------------------------------------------------------
# The container image version to use (e.g., 'latest', a version number, or a digest)
# Frequency (in seconds) at which Citadel queries the agent for metrics (platform/container stats)
JobConfiguration__MonitoringInterval=10
# Frequency (in seconds) at which Citadel writes monitored data from memory to the database
JobConfiguration__FlashInterval=60

# The duration (in minutes) that an access token remains valid after issuance
Jwt__AccessToken__ValidForMinutes=15
# The duration (in days) that a refresh token remains valid for generating new access tokens
Jwt__RefreshToken__ValidForDays=30
# The secret key used for signing and validating JWT tokens (leave empty to use a default key)
Jwt__Key=
# Dedicated key used to encrypt local stored secrets and external provider tokens.
# Leave empty to generate and reuse ./data/secret-encryption-key in the Citadel data volume.
Secrets__EncryptionKey=

# Allowed browser origins for CORS and OIDC login return URLs.
# Set Cors__0, Cors__1, etc. when Citadel is served behind explicit frontend origins.

# Whether to enable the Swagger/OpenAPI documentation and UI interface
EnableSwagger=true
# Whether to enable ANSI color codes in the console log output
EnableLogColor=true

# ------------------------------------------------------------------
# --------------- Automation Settings ------------------------------
# ------------------------------------------------------------------
Automations__Enabled=true
Automations__DenoPath=deno
Automations__WorkDir=./data/automations/runs
Automations__DenoCacheDir=./data/automations/deno-cache
Automations__InternalBaseUrl=http://127.0.0.1:8000
Automations__AllowNet=127.0.0.1:8000,localhost:8000
Automations__MaxParallelRuns=4
Automations__DefaultTimeoutSeconds=300
Automations__MaxTimeoutSeconds=1800
Automations__MaxLogBytes=1048576
Automations__PollIntervalSeconds=2
Automations__SchedulePollIntervalSeconds=30

# ------------------------------------------------------------------
# --------------- Postgres Settings -----------------------------
# ------------------------------------------------------------------
PG_HOST=postgres
PG_USER=admin
PG_PASSWORD=admin
PG_DATABASE=citadel_db

