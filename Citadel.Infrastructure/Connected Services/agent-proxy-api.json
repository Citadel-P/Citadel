    "paths": {
        "/api/v1/containers/list": {
            "get": {
                "tags": [
                    "Containers"
                ],
                "summary": "Returns a list of containers",
                "operationId": "Containers_List",
                "parameters": [
                    {
                        "name": "All",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "Limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    },
                    {
                        "name": "Size",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "Filters",
                        "in": "query",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "boolean"
                                },
                                "nullable": true
                            }
                        }
                    }
                ],
                "responses": {
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ContainerSummary"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/containers/logs/stream": {
            "post": {
                "tags": [
                    "Containers"
                ],
                "summary": "Request to (start/stop) stream container logs",
                "operationId": "Containers_StreamContainerLogs",
                "requestBody": {
                    "description": "Request params",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StreamLogsRequest"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StreamLogsRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/StreamLogsRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LogView"
                                }
                            }
                        }
                    }
                }
            }
        },
