                            "type": "string"
                        },
                        "nullable": true
                    },
                    "NetworkID": {
                        "type": "string",
                        "nullable": true
                    },
                    "EndpointID": {
                        "type": "string",
                        "nullable": true
                    },
                    "Gateway": {
                        "type": "string",
                        "nullable": true
                    },
                    "IPAddress": {
                        "type": "string",
                        "nullable": true
                    },
                    "IPPrefixLen": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "IPv6Gateway": {
                        "type": "string",
                        "nullable": true
                    },
                    "GlobalIPv6Address": {
                        "type": "string",
                        "nullable": true
                    },
                    "GlobalIPv6PrefixLen": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "DriverOpts": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string",
                            "nullable": true
                        },
                        "nullable": true
                    },
                    "DNSNames": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "nullable": true
                    }
