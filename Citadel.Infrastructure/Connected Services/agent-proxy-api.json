            "LogView": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "MountPoint": {
                "type": "object",
                "properties": {
                    "Type": {
                        "$ref": "#/components/schemas/MountPointType"
                    },
                    "Name": {
                        "type": "string",
                        "nullable": true
                    },
                    "Source": {
