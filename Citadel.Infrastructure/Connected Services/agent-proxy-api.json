                    },
                    "Propagation": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "MountPointType": {
                "enum": [
                    "Bind",
                    "Volume",
                    "Tmpfs",
                    "Npipe",
                    "Cluster"
