                    "Image": {
                        "type": "string",
                        "nullable": true
                    },
                    "ImageID": {
                        "type": "string",
                        "nullable": true
                    },
                    "Command": {
                        "type": "string",
                        "nullable": true
                    },
                    "Created": {
                        "type": "integer",
                        "format": "int64",
                        "nullable": true
                    },
                    "Ports": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Port"
                        },
                        "nullable": true
                    },
                    "SizeRw": {
                        "type": "integer",
