<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="dbup-sqlite" Version="6.0.1" />
	<PackageReference Include="EFCore.BulkExtensions" Version="9.0.1" />
	<PackageReference Include="EFCore.BulkExtensions.Sqlite" Version="9.0.1" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.12.0" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="Migrations\*.sql" /> <!--for dbup-->
  </ItemGroup>
	
  <ItemGroup>
	  <ProjectReference Include="..\Citadel.Contracts\Citadel.Hosting.Common\Citadel.Hosting.Common.csproj" />
  </ItemGroup>

   <ItemGroup>
	   <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\container_service.proto" GrpcServices="Client" Link="Protos\container_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\image_service.proto" GrpcServices="Client" Link="Protos\image_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\platform_service.proto" GrpcServices="Client" Link="Protos\platform_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\network_service.proto" GrpcServices="Client" Link="Protos\network_service.proto" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\volume_service.proto" GrpcServices="Client" Link="Protos\volume_service.proto" />

	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\Common\platform_model.proto" GrpcServices="None" Link="Protos\Common\platform_model.proto" />
	   <Protobuf Include="..\Citadel.Contracts\Citadel.Hosting.Common\Protos\Common\container_model.proto" GrpcServices="None" Link="Protos\Common\container_model.proto" />
   </ItemGroup>

   <ItemGroup>
     <Folder Include="Migrations\" />
   </ItemGroup>

</Project>
