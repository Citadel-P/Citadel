{
  "name": "citadel-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run validate && next build",
    "build:api": "npm run validate:api && redocly build-docs ../schema/public-v1.json --output api-out/index.html --disableGoogleFont --title \"Citadel API Reference\" && node scripts/finalize-api-output.mjs",
    "dev": "next dev",
    "start": "serve out",
    "start:api": "serve api-out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:api": "redocly lint ../schema/public-v1.json",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-links.mjs",
    "validate:api": "node scripts/validate-api-schema.mjs && npm run lint:api",
    "test:static": "node scripts/smoke-static.mjs",
    "test:api": "node scripts/smoke-api-static.mjs",
    "test:config": "node --test scripts/site-config.test.mjs scripts/validate-links.test.mjs scripts/doc-redirects.test.mjs"
  },
  "dependencies": {
    "cnfast": "0.2.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redoc": "3.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.69.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
