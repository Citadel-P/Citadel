# Leave blank to use ghcr.io/citadel-p/citadel:latest.
# Optional: set a complete image address to pin a version or use another registry.
CITADEL_IMAGE=
COMPOSE_PROJECT_NAME=citadel

# Set a unique database password before starting. Keep this file private.
# Use letters and numbers without surrounding quotes.
# To generate a password: openssl rand -hex 32
PG_HOST=pg_db
PG_PORT=5432
PG_USER=citadel
PG_DATABASE=citadel
PG_PASSWORD=

# Local access. Configure HTTPS before sharing the installation over a network.
CITADEL_BIND_ADDRESS=127.0.0.1
CITADEL_HTTP_PORT=18000
CITADEL_EDGE_PORT=18001
CITADEL_TRANSPORT_MODE=Disabled
CITADEL_PUBLIC_URL=http://localhost:18000
CITADEL_EDGE_PUBLIC_GRPC_URL=http://localhost:18001
CITADEL_HTTP_ALLOWED_HOSTS=localhost;127.0.0.1

# Citadel generates signing/encryption keys and persists them in citadel_data.
# Preserve that volume together with the PostgreSQL volume.
CITADEL_PASSWORDS_MINIMUM_LENGTH=15
# MFA is optional; setup and administrator Profile settings control the policy.
# Optional minimum the UI cannot weaken:
# CITADEL_MFA_POLICY=RequiredForAdministrators
CITADEL_HTTP_OPENAPI_ENABLED=false

# Update checks are configured in setup or administrator Profile settings.
# Optional: force checks off (api.github.com; no Citadel telemetry).
# CITADEL_UPDATE_CHECKS_ENABLED=false
