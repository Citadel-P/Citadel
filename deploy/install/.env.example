# Required: set a unique database password. Keep this file private.
# Use letters and numbers without surrounding quotes.
# Generate one with: openssl rand -hex 32
PG_PASSWORD=

# Optional: uncomment to change the local browser port.
# Open http://localhost:18000 after starting Citadel.
# CITADEL_HTTP_PORT=18000

# HTTPS, Edge Agents, image versions, and other optional settings:
# https://docs.citadelplane.com/getting-started/configuration

# After first-run setup, enable Core and bundled PostgreSQL updates with:
# https://docs.citadelplane.com/operations/upgrade-and-rollback/#enable-in-app-updates
# The setup command writes CITADEL_UPDATE_STATE_DIRECTORY after verification.
# Do not set it to an empty or unregistered directory.
