# Leave blank to use ghcr.io/citadel-p/citadel:latest.
# Optional: set a complete image address to pin a version or use another registry.
CITADEL_IMAGE=
COMPOSE_PROJECT_NAME=citadel

# Set a unique database password before starting. Keep this file private.
# Use letters and numbers without surrounding quotes.
# To generate a password: openssl rand -hex 32
PG_HOST=pg_db
PG_PORT=5432
PG_USER=citadel
PG_DATABASE=citadel
PG_PASSWORD=

# Local access. Configure HTTPS before sharing the installation over a network.
CITADEL_BIND_ADDRESS=127.0.0.1
CITADEL_HTTP_PORT=18000
CITADEL_EDGE_PORT=18001
Transport__Mode=Disabled
Transport__PublicUrl=http://localhost:18000
EdgeAgent__PublicGrpcUrl=http://localhost:18001
AllowedHosts=localhost;127.0.0.1

# Citadel generates signing/encryption keys and persists them in citadel_data.
# Preserve that volume together with the PostgreSQL volume.
Passwords__MinimumLength=15
Mfa__Policy=Optional
EnableSwagger=false
