# Copy the ID from Citadel’s generated Agent setup command. Do not generate a separate ID.
CITADEL_AGENT_ID=replace-with-generated-agent-id
# Inbound Build Pool Agent. Pool membership is configured in Citadel Core.
CITADEL_CORE_PUBLIC_KEY=replace-with-citadel-core-hub-public-key

# CITADEL_AGENT_PORT=9000
# Optional TLS for inbound connections:
# CITADEL_AGENT_TLS_MODE=Direct
# CITADEL_AGENT_TLS_CERTIFICATE_PATH=/etc/citadel/tls/agent-fullchain.pem
# CITADEL_AGENT_TLS_PRIVATE_KEY_PATH=/etc/citadel/tls/agent-key.pem

# Concurrent build attempts on this Agent, including pushes and cleanup.
# CITADEL_AGENT_BUILD_SLOTS=2
# CITADEL_AGENT_DATA_SLOTS=2
# CITADEL_AGENT_HEAVY_SLOTS=2

# Concurrent Deno actions on this Agent, also bounded by CITADEL_AGENT_HEAVY_SLOTS.
# CITADEL_AGENT_AUTOMATION_SLOTS=4
