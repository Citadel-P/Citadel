# Citadel configuration. Copy to .env and keep your credentials private.
# Uncomment optional settings only when you need to change their defaults.

# Installation
COMPOSE_PROJECT_NAME=citadel-rust
CITADEL_IMAGE=citadel-rust:local

# PostgreSQL (pg_db is the database bundled with Compose).
PG_HOST=pg_db
PG_PORT=5432
PG_USER=citadel
PG_DATABASE=citadel
# Generate a password with: openssl rand -hex 32
PG_PASSWORD=

# Access and transport
CITADEL_BIND_ADDRESS=127.0.0.1
CITADEL_HTTP_PORT=18000
CITADEL_EDGE_PORT=18001
# Disabled uses local HTTP. For remote access, use ReverseProxy or Direct with HTTPS.
CITADEL_TRANSPORT_MODE=Disabled
CITADEL_PUBLIC_URL=http://localhost:18000
# The localhost value below is for local testing only. For remote Agents, set
# an address reachable from their host, e.g. https://edge.example.com with a
# gRPC reverse proxy to Core's Edge listener, and update CITADEL_HTTP_ALLOWED_HOSTS below.
# Docker Desktop development uses .env.development instead.
CITADEL_EDGE_PUBLIC_GRPC_URL=http://localhost:18001
CITADEL_HTTP_ALLOWED_HOSTS=localhost;127.0.0.1;host.docker.internal
# Optional listener ports inside Core.
# CITADEL_HTTP_LISTEN_PORT=8000
# CITADEL_EDGE_GRPC_LISTEN_PORT=8001
# ReverseProxy requires trusted proxy addresses or networks (comma-separated).
# CITADEL_HTTP_TRUSTED_PROXIES=172.30.0.2
# CITADEL_HTTP_TRUSTED_PROXY_NETWORKS=172.30.0.0/24
# CITADEL_HTTP_FORWARDED_LIMIT=1
# Direct TLS: add -f compose.direct-tls.yml and configure these mounted PEM files.
# CITADEL_TLS_HOST_DIRECTORY=./tls
# CITADEL_TLS_CERTIFICATE_PATH=/etc/citadel/tls/core-fullchain.pem
# CITADEL_TLS_PRIVATE_KEY_PATH=/etc/citadel/tls/core-key.pem
# Allowed browser origins when the frontend uses a different address.
# CITADEL_HTTP_CORS_ORIGIN_0=http://localhost:5173

# Authentication and stored secrets
# Leave keys unset to generate and persist them in the Citadel data volume.
# Preserve existing keys and the data volume when upgrading or restoring backups.
# Signing key: openssl rand -hex 32
# CITADEL_JWT_KEY=
# Encryption key: openssl rand -base64 32
# CITADEL_SECRETS_ENCRYPTION_KEY=
# Issuer defaults to CITADEL_PUBLIC_URL; audience defaults to issuer.
# CITADEL_JWT_ISSUER=http://localhost:18000
# CITADEL_JWT_AUDIENCE=http://localhost:18000
CITADEL_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
CITADEL_JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
# MFA is optional by default and can be enabled later in Profile -> Security.
# Choose an installation policy during setup or in administrator Profile settings.
# Optional override: enforce a minimum policy the UI cannot weaken.
# Optional, RequiredForAdministrators, or RequiredForAllUsers.
# Password creation/change policy, 8–128 Unicode characters. Login is unaffected.
# Keep 15 for password-only login; use a lower minimum with CITADEL_MFA_POLICY=RequiredForAllUsers.
CITADEL_PASSWORDS_MINIMUM_LENGTH=15
# CITADEL_MFA_POLICY=RequiredForAdministrators
# Service-account token lifetimes and limits.
# CITADEL_SERVICE_ACCOUNTS_DEFAULT_TOKEN_LIFETIME_DAYS=90
# CITADEL_SERVICE_ACCOUNTS_MAXIMUM_TOKEN_LIFETIME_DAYS=365
# CITADEL_SERVICE_ACCOUNTS_MAXIMUM_ACTIVE_TOKENS_PER_ACCOUNT=10
# Unattended first-run setup: set all three and mount the password file read-only.
# CITADEL_BOOTSTRAP_ADMIN_NAME=citadel-admin
# CITADEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# CITADEL_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/citadel-admin-password

# Logging and API documentation
CITADEL_HTTP_OPENAPI_ENABLED=false
# Human-readable text by default; use json for structured log collection.
CITADEL_LOG_FORMAT=text
# Unset to detect an interactive terminal; JSON never includes ANSI colors.
CITADEL_LOG_COLOR_ENABLED=false
# Optional log verbosity: error, warn, info, debug, or trace.
# RUST_LOG=info

# Frequency (in seconds) at which Citadel queries the agent for metrics (platform/container stats)
CITADEL_STATS_POLL_INTERVAL_SECONDS=10
# Frequency (in seconds) at which Citadel writes monitored data from memory to the database
CITADEL_STATS_FLUSH_INTERVAL_SECONDS=60

# Automation
CITADEL_AUTOMATIONS_ENABLED=true
CITADEL_AUTOMATIONS_MAX_PARALLEL_RUNS=4
# CITADEL_AUTOMATIONS_DEFAULT_TIMEOUT_SECONDS=300
# CITADEL_AUTOMATIONS_MAX_TIMEOUT_SECONDS=1800

# Builds
# CITADEL_BUILDS_MAX_PARALLEL_RUNS=4
# CITADEL_BUILDS_RUN_CLEANUP_ENABLED=true
# CITADEL_BUILDS_RUN_RETENTION_DAYS=90

# Backups
# CITADEL_BACKUPS_ENABLED=true
# CITADEL_BACKUPS_MAX_PARALLEL_RUNS=2
# Timeout for repository operations and restores; backup policies have their own timeout.
# CITADEL_BACKUPS_DEFAULT_TIMEOUT_SECONDS=120
# Allowed Core filesystem repository locations. Mount custom paths in Compose.
# Add CITADEL_BACKUPS_ALLOWED_CORE_PATH_1, CITADEL_BACKUPS_ALLOWED_CORE_PATH_2, etc. for additional locations.
# CITADEL_BACKUPS_ALLOWED_CORE_PATH_0=/app/data/backups/repositories

# Agent connections
# HTTP Agents require a trusted private network; set false to require HTTPS.
CITADEL_CORE_AGENT_ALLOW_INSECURE=true
# Private CA used to verify direct Agent HTTPS connections.
# CITADEL_CORE_AGENT_CA_CERTIFICATE_PATH=/etc/citadel/tls/agent-ca.pem
# Private Core CA distributed to Swarm node agents.
# CITADEL_NODE_AGENT_CA_CERTIFICATE_PATH=/etc/citadel/tls/core-ca.pem
# Optional Agent image override, for example when using a private registry.
# CITADEL_EDGE_AGENT_IMAGE=registry.example.com/citadel/agent:1.0.0

# Operator-verified OpenSSH known_hosts file for Git (mount read-only or populate the data volume).
# SSH rejects unknown or changed host keys. Defaults to <CITADEL_DATA_ROOT>/git-known-hosts.
# CITADEL_GIT_KNOWN_HOSTS_PATH=/app/data/git-known-hosts

# Choose release checks in setup or administrator Profile -> Instance settings.
# Checks are on by default, contact api.github.com, and send no Citadel telemetry.
# Optional operator restriction: false disables checks and locks the UI control.
# CITADEL_UPDATE_CHECKS_ENABLED=false
