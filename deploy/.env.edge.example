# Outbound Agent. Obtain an enrollment token from Citadel Core.
CITADEL_AGENT_MODE=edge
CITADEL_CORE_URL=https://citadel.example.com
CITADEL_EDGE_ENROLLMENT_TOKEN=replace-with-enrollment-token

# CITADEL_EDGE_AGENT_PROFILE=edge-agent
# Optional private CA; server hostname verification remains enabled:
# CITADEL_EDGE_CORE_CA_CERTIFICATE_PATH=/etc/citadel/tls/core-ca.pem
# Persist these paths across container restarts:
# CITADEL_EDGE_AGENT_KEY_PATH=/app/data/edge-agent.key
# CITADEL_EDGE_IDENTITY_PATH=/app/data/edge-agent.identity.json
