# ------------------------------------------------------------------
# Citadel production environment template
# ------------------------------------------------------------------
# Copy this file to .env, replace the active placeholders, and keep .env
# private. Uncomment optional settings only when you need to override a
# documented default.

# Container image version to deploy, such as latest, 1.0.0, or a digest.
# CITADEL_IMAGE_TAG=latest

# Frequency in seconds at which Citadel reads Platform and Container metrics.
# JobConfiguration__MonitoringInterval=10
# Frequency in seconds at which Citadel persists buffered metrics.
# JobConfiguration__FlashInterval=60

# ------------------------------------------------------------------
# Transport
# ------------------------------------------------------------------
# ReverseProxy is the recommended production mode. The proxy terminates TLS.
Transport__Mode=ReverseProxy
Transport__PublicUrl=https://citadel.example.com
EdgeAgent__PublicGrpcUrl=https://citadel.example.com:8444
AllowedHosts=citadel.example.com

# Optional listener ports.
# Transport__ApiPort=8000
# Transport__EdgeGrpcPort=8001

# Stable address of the immediate reverse proxy. At least one known proxy or
# known network is required in ReverseProxy mode.
Transport__ForwardedHeaders__KnownProxies=172.30.0.2
# Transport__ForwardedHeaders__KnownNetworks=172.30.0.0/24
# Transport__ForwardedHeaders__ForwardLimit=1

# Regular Agents authenticate Core requests over HTTP by default. Keep them on
# a trusted private network or VPN, or set this to false and configure Agent TLS.
# AgentTransport__AllowInsecure=true
# AgentTransport__CaCertificatePath=/etc/citadel/tls/agent-ca.pem

# To terminate TLS directly in Citadel, set Direct mode, remove the
# ForwardedHeaders settings above, configure these PEM paths, and use the
# docker-compose.direct-tls.yml overlay.
# Transport__Mode=Direct
# Transport__Certificate__Path=/etc/citadel/tls/core-fullchain.pem
# Transport__Certificate__PrivateKeyPath=/etc/citadel/tls/core-key.pem
# CITADEL_TLS_HOST_DIRECTORY=./tls

# ------------------------------------------------------------------
# Authentication and stored secrets
# ------------------------------------------------------------------
Jwt__Issuer=https://citadel.example.com
Jwt__Audience=https://citadel.example.com
# Access-token lifetime in minutes.
# Jwt__AccessToken__ValidForMinutes=15
# Refresh-token lifetime in days.
# Jwt__RefreshToken__ValidForDays=30
# Optional signing key. Leave unset to generate and persist one in the Citadel
# data volume.
# Jwt__Key=

# Optional base64-encoded 32-byte key for stored secrets and provider tokens.
# Leave unset to generate and persist a key in the Citadel data volume.
# Secrets__EncryptionKey=

# Optional, RequiredForAdministrators, or RequiredForAllUsers.
# Mfa__Policy=Optional

# Optional unattended first-run setup. Leave all three values unset to use the
# browser setup page. The password file must be mounted read-only.
# Bootstrap__AdminName=citadel-admin
# Bootstrap__AdminEmail=admin@example.com
# Bootstrap__AdminPasswordFile=/run/secrets/citadel-admin-password

# Allowed browser origins for CORS and OIDC return URLs. Add Cors__1, Cors__2,
# and later entries only when the browser uses a different origin.
# Cors__0=https://citadel.example.com

# Expose Swagger/OpenAPI only when it is intentionally required.
# EnableSwagger=false
# ANSI colors are normally disabled in container logs.
# EnableLogColor=false

# ------------------------------------------------------------------
# Automation
# ------------------------------------------------------------------
# Automations__Enabled=true
# Automations__MaxParallelRuns=4

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
# Use pg_db for the PostgreSQL service bundled with docker-compose.yml.
# PG_HOST=pg_db
PG_USER=citadel
PG_PASSWORD=replace-with-a-strong-database-password
PG_DATABASE=citadel
