{
    "profiles": {
        "Citadel.WebApi": {
            "commandName": "Project",
            "launchBrowser": true,
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5001"
        },
        "Docker": {
            "commandName": "Docker",
            "launchBrowser": false,
            "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
            "publishAllPorts": true,
            "httpPort": 8000,
            "environmentVariables": {
                "ASPNETCORE_URLS": "http://+:8000",
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    }
}