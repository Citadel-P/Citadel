{
    "Serilog": {
        "LevelSwitches": {
            "$customSwitch": "Warning"
        },
        "MinimumLevel": {
            "ControlledBy": "$customSwitch",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore.Authentication": "Information",
                "System": "Warning",
                "Serilog": "Warning"
            }
        },
        "WriteTo:Async": {
            "Name": "Async",
            "Args": {
                "configure": [
                    {
                        "Args": {
                            "path": "./data/logs/trace.log",
                            "retainedFileCountLimit": 20,
                            "rollingInterval": "Day",
                            "rollOnFileSizeLimit": true,
                            "fileSizeLimitBytes": 6000000,
                            "shared": true
                        },
                        "Name": "File"
                    }
                ]
            }
        },
        "WriteTo:Console": {
            "Name": "Console"
        }
    },
    "Jwt": {
        "Issuer": "http://localhost:8000",
        "Audience": "http://localhost:8000",
        "ValidFor": 8,
        "Key": ""
    },
    "AllowedHosts": "*"
}