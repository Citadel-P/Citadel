{
    "Serilog": {
        "LevelSwitches": {
            "$customSwitch": "Warning"
        },
        "MinimumLevel": {
            "ControlledBy": "$customSwitch",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore.Authentication": "Warning",
                "System": "Warning",
                "Serilog": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "File",
                            "Args": {
                                "path": "/app/data/logs/trace.log",
                                "rollingInterval": "Day",
                                "retainedFileCountLimit": 20,
                                "rollOnFileSizeLimit": true,
                                "fileSizeLimitBytes": 6000000,
                                "shared": true
                            }
                        }
                    ]
                }
            },
            {
                "Name": "Console"
            }
        ]
    },
    "Jwt": {
        "Issuer": "http://localhost:8000",
        "Audience": "http://localhost:8000",
        "AccessToken": { "ValidForMinutes": 15 },
        "RefreshToken": { "ValidForDays": 30 },
        "Key": ""
    },
    "JobConfiguration": {
        "SystemInfoInterval": 20,
        "ContainersInfoInterval": 20,
        "BatchSize": 500,
        "FlashInterval": 60
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:8000"
            },
            "Http2": {
                "Url": "http://+:8001",
                "Protocols": "Http2"
            }
        }
    },
    "Cors": [ "http://localhost:8000", "http://localhost:5173" ]
}