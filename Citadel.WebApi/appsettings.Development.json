{
    "Serilog": {
        "LevelSwitches": {
            "$customSwitch": "Information"
        },
        "MinimumLevel": {
            "ControlledBy": "$customSwitch",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore.Authentication": "Information",
                "System": "Warning",
                "Serilog": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "File",
                            "Args": {
                                "path": "/app/data/logs/trace.log",
                                "rollingInterval": "Day",
                                "retainedFileCountLimit": 20,
                                "rollOnFileSizeLimit": true,
                                "fileSizeLimitBytes": 6000000,
                                "shared": true
                            }
                        }
                    ]
                }
            },
            {
                "Name": "Console"
            }
        ]
    },
    "Cors": [ "http://localhost:8000", "http://localhost:5173" ],
    "Jwt": {
        "Issuer": "http://localhost:8000",
        "Audience": "http://localhost:8000",
        "AccessToken": { "ValidForMinutes": 1440 },
        "RefreshToken": { "ValidForDays": 30 },
        "Key": ""
    }
}