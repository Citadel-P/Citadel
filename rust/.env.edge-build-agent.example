# Outbound Build Pool Agent. Obtain a Build Pool enrollment token from Core.
CITADEL_AGENT_MODE=edge
CITADEL_EDGE_AGENT_PROFILE=edge-build-agent
CITADEL_CORE_URL=https://citadel.example.com:8444
CITADEL_EDGE_ENROLLMENT_TOKEN=replace-with-build-edge-pool-enrollment-token

# Optional private CA; server hostname verification remains enabled:
# CITADEL_EDGE_CORE_CA_CERTIFICATE_PATH=/etc/citadel/tls/core-ca.pem
# Persist these paths across container restarts:
# CITADEL_EDGE_AGENT_KEY_PATH=/app/data/edge-build-agent.key
# CITADEL_EDGE_IDENTITY_PATH=/app/data/edge-build-agent.identity.json
