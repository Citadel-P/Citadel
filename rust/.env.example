# Citadel configuration. Copy to .env and keep your credentials private.
# Uncomment optional settings only when you need to change their defaults.

# Installation
COMPOSE_PROJECT_NAME=citadel-rust
CITADEL_IMAGE=citadel-rust:local

# PostgreSQL (pg_db is the database bundled with Compose).
PG_HOST=pg_db
PG_PORT=5432
PG_USER=citadel
PG_DATABASE=citadel
# Generate a password with: openssl rand -hex 32
PG_PASSWORD=

# Access and transport
CITADEL_BIND_ADDRESS=127.0.0.1
CITADEL_HTTP_PORT=18000
CITADEL_EDGE_PORT=18001
# Disabled uses local HTTP. For remote access, use ReverseProxy or Direct with HTTPS.
Transport__Mode=Disabled
Transport__PublicUrl=http://localhost:18000
# The localhost value below is for local testing only. For remote Agents, set
# an address reachable from their host, e.g. https://edge.example.com with a
# gRPC reverse proxy to Core's Edge listener, and update AllowedHosts below.
# Docker Desktop development uses rust/.env.development instead.
EdgeAgent__PublicGrpcUrl=http://localhost:18001
AllowedHosts=localhost;127.0.0.1;host.docker.internal
# Optional listener ports inside Core.
# Transport__ApiPort=8000
# Transport__EdgeGrpcPort=8001
# ReverseProxy requires trusted proxy addresses or networks (comma-separated).
# Transport__ForwardedHeaders__KnownProxies=172.30.0.2
# Transport__ForwardedHeaders__KnownNetworks=172.30.0.0/24
# Transport__ForwardedHeaders__ForwardLimit=1
# Direct TLS: add -f rust/compose.direct-tls.yml and configure these mounted PEM files.
# CITADEL_TLS_HOST_DIRECTORY=./tls
# Transport__Certificate__Path=/etc/citadel/tls/core-fullchain.pem
# Transport__Certificate__PrivateKeyPath=/etc/citadel/tls/core-key.pem
# Allowed browser origins when the frontend uses a different address.
# Cors__0=http://localhost:5173

# Authentication and stored secrets
# Leave keys unset to generate and persist them in the Citadel data volume.
# Preserve existing keys and the data volume when upgrading or restoring backups.
# Signing key: openssl rand -hex 32
# Jwt__Key=
# Encryption key: openssl rand -base64 32
# Secrets__EncryptionKey=
# Issuer defaults to Transport__PublicUrl; audience defaults to issuer.
# Jwt__Issuer=http://localhost:18000
# Jwt__Audience=http://localhost:18000
Jwt__AccessToken__ValidForMinutes=15
Jwt__RefreshToken__ValidForDays=30
# MFA is optional by default. Use RequiredForAdministrators to require
# enrollment immediately after the initial administrator is created.
# Optional, RequiredForAdministrators, or RequiredForAllUsers.
# Password creation/change policy, 8–128 Unicode characters. Login is unaffected.
# Keep 15 for password-only login; use a lower minimum with Mfa__Policy=RequiredForAllUsers.
Passwords__MinimumLength=15
Mfa__Policy=Optional
# Service-account token lifetimes and limits.
# ServiceAccounts__DefaultTokenLifetimeDays=90
# ServiceAccounts__MaximumTokenLifetimeDays=365
# ServiceAccounts__MaximumActiveTokensPerAccount=10
# Unattended first-run setup: set all three and mount the password file read-only.
# Bootstrap__AdminName=citadel-admin
# Bootstrap__AdminEmail=admin@example.com
# Bootstrap__AdminPasswordFile=/run/secrets/citadel-admin-password

# Logging and API documentation
EnableSwagger=false
# Human-readable text by default; use json for structured log collection.
LogFormat=text
# Unset to detect an interactive terminal; JSON never includes ANSI colors.
EnableLogColor=false
# Optional log verbosity: error, warn, info, debug, or trace.
# RUST_LOG=info

# Frequency (in seconds) at which Citadel queries the agent for metrics (platform/container stats)
JobConfiguration__MonitoringInterval=10
# Frequency (in seconds) at which Citadel writes monitored data from memory to the database
JobConfiguration__FlashInterval=60

# Automation
Automations__Enabled=true
Automations__MaxParallelRuns=4
# Automations__DefaultTimeoutSeconds=300
# Automations__MaxTimeoutSeconds=1800

# Builds
# Builds__MaxParallelRuns=4
# Builds__RunCleanupEnabled=true
# Builds__RunRetentionDays=90

# Backups
# Backups__Enabled=true
# Backups__MaxParallelRuns=2
# Timeout for repository operations and restores; backup policies have their own timeout.
# Backups__DefaultTimeoutSeconds=120
# Allowed Core filesystem repository locations. Mount custom paths in Compose.
# Add Backups__AllowedCorePaths__1, __2, etc. for additional locations.
# Backups__AllowedCorePaths__0=/app/data/backups/repositories

# Agent connections
# HTTP Agents require a trusted private network; set false to require HTTPS.
AgentTransport__AllowInsecure=true
# Private CA used to verify direct Agent HTTPS connections.
# AgentTransport__CaCertificatePath=/etc/citadel/tls/agent-ca.pem
# Private Core CA distributed to Swarm node agents.
# CITADEL_NODE_AGENT_CA_CERTIFICATE_PATH=/etc/citadel/tls/core-ca.pem
# Optional Agent image override, for example when using a private registry.
# CITADEL_EDGE_AGENT_IMAGE=registry.example.com/citadel/agent:1.0.0
