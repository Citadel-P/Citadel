# Copy to .env and fill the blank values before starting Compose.
COMPOSE_PROJECT_NAME=citadel-rust
CITADEL_IMAGE=citadel-rust:local
CITADEL_VERSION=0.0.0-local

PG_USER=citadel
PG_DATABASE=citadel
# Generate a password: openssl rand -hex 32
PG_PASSWORD=
# Generate separately: openssl rand -hex 32
Jwt__Key=
# Generate once and retain with backups: openssl rand -base64 32
Secrets__EncryptionKey=
# Linux/WSL: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Local HTTP defaults. Configure TLS/reverse-proxy transport before remote use.
CITADEL_BIND_ADDRESS=127.0.0.1
CITADEL_HTTP_PORT=18000
CITADEL_EDGE_PORT=18001
Transport__Mode=Disabled
Transport__ApiPort=8000
Transport__EdgeGrpcPort=8001
Transport__PublicUrl=http://localhost:18000
EdgeAgent__PublicGrpcUrl=http://localhost:18001
AllowedHosts=localhost;127.0.0.1;host.docker.internal
RUST_LOG=citadel_server=info,citadel_adapters=info
