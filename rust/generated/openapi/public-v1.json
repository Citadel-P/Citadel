{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "requestId"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "type": "boolean"
          },
          "docker": {
            "type": "boolean"
          },
          "setup": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ready",
              "not-ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "docker",
          "setup"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Citadel Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Success"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Process liveness"
      }
    }
  }
}
